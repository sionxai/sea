# Firebase project for the server-only Admin SDK. Do not put service-account files in this project.
FIREBASE_PROJECT_ID=sea-forest-kit-sionxai

# A bcrypt hash only; never commit the administrator's plaintext password.
ADMIN_PASSWORD_HASH=

# Required for signed administrator cookies. Use at least 32 random characters.
ADMIN_SESSION_SECRET=

# Used to deterministically recover a lookup code for a retried idempotency key.
# Use at least 32 random characters and never commit the real value.
ORDER_LOOKUP_SECRET=

# Used only by Firebase Emulator Suite / local development. Never set in production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Both remain disabled unless a separately controlled procedure enables them.
ALLOW_LIVE_FIRESTORE=false
TRUST_PROXY=false

# Production seeding is disabled by default. Enable only for a controlled admin seed action.
FIREBASE_ALLOW_SEED=false

# Existing SQLite-backed member login, region, and certification flows.
SESSION_SECRET=
ENABLE_DEMO_ACCOUNTS=true
DEMO_ACCOUNT_PASSWORD=replace-for-local-demo
